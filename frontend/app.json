{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.realtimetextocr.xasg2i",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture screens to translate on-screen text",
        "NSPhotoLibraryUsageDescription": "Translate text from your saved screenshots"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.realtimetextocr.xasg2i",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Translate text from your saved screenshots",
          "cameraPermission": "Capture screens to translate on-screen text"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "Translate text from your latest screenshots",
          "savePhotosPermission": "Save translated screens to your gallery"
        }
      ],
      "react-native-frame-capture"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
